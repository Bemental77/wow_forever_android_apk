+  void DxvkContext::profFrameBoundary(bool enabled) {
+    auto vkd = m_device->vkd();
+
+    if (m_profActive) {
+      // Close the open segment in the current command list. No flush, no wait.
+      this->profMark(ProfNone);
+
+      auto& slot = m_profSlots[m_profSlot];
+      slot.marks = std::move(m_profMarks);
+      slot.frame = m_profFrame;
+      slot.age = 0;
+      slot.pending = true;
+
+      m_profMarks = std::vector<ProfMark>();
+      m_profActive = false;
+      m_profCurType = ProfNone;
+    }
+
+    // Poll pending slots without blocking
+    for (auto& slot : m_profSlots) {
+      if (!slot.pending)
+        continue;
+
+      if (this->profReport(slot)) {
+        slot.pending = false;
+        slot.marks.clear();
+      } else if (++slot.age > 60) {
+        Logger::warn(str::format("PROF frame ", slot.frame, " dropped: results not ready after 60 frames"));
+        slot.pending = false;
+        slot.marks.clear();
+      }
+    }
+
+    if (!enabled)
+      return;
+
+    auto now = dxvk::high_resolution_clock::now();
+
+    if (now - m_profLast < std::chrono::seconds(3))
+      return;
+
+    uint32_t k = 0;
+
+    while (k < m_profSlots.size() && m_profSlots[k].pending)
+      k++;
+
+    if (k == m_profSlots.size())
+      return;
+
+    auto& slot = m_profSlots[k];
+
+    if (!slot.pool) {
+      VkQueryPoolCreateInfo info = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+      info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+      info.queryCount = ProfMaxQueries;
+
+      if (vkd->vkCreateQueryPool(vkd->device(), &info, nullptr, &slot.pool) != VK_SUCCESS) {
+        Logger::warn("PROF: Failed to create timestamp query pool");
+        slot.pool = VK_NULL_HANDLE;
+        return;
+      }
+    }
+
+    m_profLast = now;
+
+    // Reset in the command buffer; we are outside of any render pass here
+    // since the frame's commands were just flushed.
+    m_cmd->cmdResetQueryPoolExec(slot.pool, 0, ProfMaxQueries);
+
+    m_profSlot = k;
+    m_profPool = slot.pool;
+    m_profMarks.clear();
+    m_profMarks.reserve(ProfMaxQueries);
+    m_profFrame += 1;
+    m_profActive = true;
+    m_profCurType = ProfNone;
+
+    // Work recorded into the current command list belongs to the new frame
+    this->profMark(ProfXfer);
+  }
+
+
+  const std::string& DxvkContext::profShaderInfo(const DxvkShader* shader) {
+    auto entry = m_profShaderInfo.find(shader);
+
+    if (entry != m_profShaderInfo.end())
+      return entry->second;
+
+    std::string info;
+
+    if (!shader) {
+      info = "cs=null";
+    } else {
+      std::string name = shader->debugName();
+      SpirvCodeBuffer code = shader->getRawCode();
+
+      const uint32_t* w = code.data();
+      uint32_t n = code.dwords();
+      uint32_t lx = 0, ly = 0, lz = 0;
+
+      for (uint32_t i = 5; i < n; ) {
+        uint32_t op = w[i] & 0xffffu;
+        uint32_t len = w[i] >> 16;
+
+        if (!len)
+          break;
+
+        // OpExecutionMode %entry LocalSize x y z
+        if (op == 16u && len >= 6u && i + 5 < n && w[i + 2] == 17u) {
+          lx = w[i + 3]; ly = w[i + 4]; lz = w[i + 5];
+        }
+
+        i += len;
+      }
+
+      uint32_t ubo = 0, ssbo = 0, sampled = 0, storageImg = 0,
+               uniformTexel = 0, storageTexel = 0, samplers = 0, other = 0;
+      uint32_t writable = 0;
+
+      const auto& bindings = shader->getBindings();
+
+      for (uint32_t s = 0; s < DxvkDescriptorSets::SetCount; s++) {
+        for (uint32_t b = 0; b < bindings.getBindingCount(s); b++) {
+          const auto& bi = bindings.getBinding(s, b);
+
+          if (bi.access & VK_ACCESS_SHADER_WRITE_BIT)
+            writable += 1;
+
+          switch (bi.descriptorType) {
+            case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+            case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC: ubo++; break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC: ssbo++; break;
+            case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:          sampled++; break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:          storageImg++; break;
+            case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:   uniformTexel++; break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:   storageTexel++; break;
+            case VK_DESCRIPTOR_TYPE_SAMPLER:                samplers++; break;
+            default:                                        other++; break;
+          }
+        }
+      }
+
+      info = str::format("wg=", lx, ",", ly, ",", lz, " cs=", name,
+        " bind[ubo=", ubo, " ssbo=", ssbo, " srvImg=", sampled, " uavImg=", storageImg,
+        " srvTexBuf=", uniformTexel, " uavTexBuf=", storageTexel, " smp=", samplers,
+        " other=", other, " writable=", writable, "]");
+
+      Logger::warn(str::format("PROF shader ", info, " spirvDwords=", n));
+    }
+
+    return m_profShaderInfo.emplace(shader, std::move(info)).first->second;
+  }
+
+
+  bool DxvkContext::profReport(ProfSlot& slot) {
+    auto vkd = m_device->vkd();
+    uint32_t count = uint32_t(slot.marks.size());
+
+    if (!count)
+      return true;
+
+    std::vector<uint64_t> raw(2 * count);
+
+    VkResult vr = vkd->vkGetQueryPoolResults(vkd->device(), slot.pool, 0, count,
+      raw.size() * sizeof(uint64_t), raw.data(), 2 * sizeof(uint64_t),
+      VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+
+    if (vr != VK_SUCCESS && vr != VK_NOT_READY) {
+      Logger::warn(str::format("PROF: vkGetQueryPoolResults failed: ", vr));
+      return true;
+    }
+
+    for (uint32_t i = 0; i < count; i++) {
+      if (!raw[2 * i + 1])
+        return false;
+    }
+
+    std::vector<uint64_t> ts(count);
+
+    for (uint32_t i = 0; i < count; i++)
+      ts[i] = raw[2 * i];
+
+    const auto& marks = slot.marks;
+    uint64_t frameId = slot.frame;
+
+    double period = double(m_device->properties().core.properties.limits.timestampPeriod);
+    const char* names[] = { "END", "RP", "CS", "XFER" };
+
+    double total[4] = { };
+    uint32_t segCount[4] = { };
+    uint32_t totalDraws = 0;
+    uint32_t totalDispatches = 0;
+
+    Logger::warn(str::format("PROF frame ", frameId, " begin: marks=", count,
+      (count >= ProfMaxQueries ? " (TRUNCATED)" : ""), " timestampPeriod=", period, "ns"));
+
+    for (uint32_t i = 0; i + 1 < count; i++) {
+      const auto& m = marks[i];
+
+      if (m.type == ProfNone)
+        continue;
+
+      double us = double(ts[i + 1] - ts[i]) * period / 1000.0;
+
+      total[m.type] += us;
+      segCount[m.type] += 1;
+      totalDraws += m.draws;
+      totalDispatches += m.dispatches;
+
+      if (m.type == ProfXfer && us < 2.0)
+        continue;
+
+      char buf[64];
+      std::snprintf(buf, sizeof(buf), "%.1f", us);
+
+      std::string line = str::format("PROF seq=", i, " ", names[m.type], " us=", buf);
+
+      if (m.type == ProfRp)
+        line += str::format(" draws=", m.draws, " ", m.info);
+      else if (m.type == ProfCs)
+        line += str::format(" ", m.info);
+
+      Logger::warn(line);
+    }
+
+    double sum = total[ProfRp] + total[ProfCs] + total[ProfXfer];
+    double span = double(ts[count - 1] - ts[0]) * period / 1000.0;
+
+    char buf[256];
+    std::snprintf(buf, sizeof(buf),
+      "PROF frame %llu total: gpu_busy_us=%.1f span_us=%.1f RP=%.1f (%u passes, %u draws) CS=%.1f (%u runs, %u dispatches) XFER=%.1f (%u runs)",
+      (unsigned long long)frameId, sum, span,
+      total[ProfRp], segCount[ProfRp], totalDraws,
+      total[ProfCs], segCount[ProfCs], totalDispatches,
+      total[ProfXfer], segCount[ProfXfer]);
+    Logger::warn(buf);
+    return true;
   }
 
 
