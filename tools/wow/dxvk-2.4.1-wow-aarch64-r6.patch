--- /dev/null
+++ b/src/util/wow_stats.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace dxvk::wowstats {
+
+  // wow-aarch64 r3: cheap global counters for pacing / hitch analysis
+  enum Counter : uint32_t {
+    PipeFastLinked  = 0,
+    PipeOptimized   = 1,
+    PipeCompute     = 2,
+    ShaderCompiled  = 3,
+    MemAllocs       = 4,
+    MemAllocBytes   = 5,
+    Submits         = 6,
+    Count           = 7,
+  };
+
+  inline std::atomic<uint64_t> g_counters[Count];
+
+  inline void add(Counter c, uint64_t v = 1u) {
+    g_counters[c].fetch_add(v, std::memory_order_relaxed);
+  }
+
+  inline uint64_t get(Counter c) {
+    return g_counters[c].load(std::memory_order_relaxed);
+  }
+
+}
