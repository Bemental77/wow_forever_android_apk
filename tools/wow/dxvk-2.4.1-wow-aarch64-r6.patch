+    // wow-aarch64 r3: a skipped dispatch never writes its UAVs. Zero them
+    // (and their append/consume counters) so that consumers don't read
+    // garbage from recycled memory.
+    bool always = WowSkipZeroAlways();
+    uint32_t count = 0;
+
+    for (uint32_t i = 0; i < m_state.uav.maxCount; i++) {
+      D3D11UnorderedAccessView* uav = m_state.uav.views[i].ptr();
+
+      if (!uav)
+        continue;
+
+      const void* key = nullptr;
+
+      if (uav->GetViewInfo().Dimension == D3D11_RESOURCE_DIMENSION_BUFFER)
+        key = uav->GetBufferView()->buffer().ptr();
+      else
+        key = uav->GetImageView()->image().ptr();
+
+      if (!always && !WowSkipFirstSeen(key))
+        continue;
+
+      const UINT zero[4] = { 0u, 0u, 0u, 0u };
+      ClearUnorderedAccessViewUint(uav, zero);
+
+      auto counterView = uav->GetCounterView();
+
+      if (counterView != nullptr) {
+        EmitCs([
+          cCounterView = std::move(counterView)
+        ] (DxvkContext* ctx) {
+          uint32_t value = 0u;
+          auto slice = cCounterView->slice();
+
+          ctx->updateBuffer(slice.buffer(),
+            slice.offset(), sizeof(value), &value);
+        });
+      }
+
+      count += 1;
+    }
+
+    if (count) {
+      static std::atomic<uint32_t> s_logs = { 0u };
+
+      if (!always || s_logs.fetch_add(1u) < 64u) {
+        Logger::warn(str::format("SKIP: zeroed ", count, " UAVs for ",
+          pShader->GetName(), always ? " (always)" : " (first)"));
+      }
+    }
+  }
