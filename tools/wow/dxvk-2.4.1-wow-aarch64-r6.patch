+  void WowSkipRefresh() {
+    static dxvk::high_resolution_clock::time_point s_last = { };
+    auto now = dxvk::high_resolution_clock::now();
+
+    if (now - s_last < std::chrono::seconds(2))
+      return;
+
+    s_last = now;
+
+    std::string contents;
+    std::ifstream file("C:\\dxvkskip.txt", std::ios_base::binary);
+
+    if (file) {
+      contents.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+    } else {
+      // wow-aarch64 r1: built-in default list for WoW when no file exists.
+      // An existing but empty file means skip nothing.
+      static const bool s_isWow = env::getExeBaseName().rfind("Wow", 0) == 0;
+
+      if (s_isWow) {
+        contents =
+          "# built-in default\n"
+          "CS_f27caeb1dfb50263f0ca76f8585ee9ab7258f56a\n"
+          "CS_940a0c96886f320234330b4d18cb6fa4d43f51ca\n"
+          "CS_e2e66a6bb3d4cc162df043f02106d2699a600389\n"
+          "CS_fc56cc5160b1983e82ea43ce66ff61c000a846d7\n"
+          "CS_4ee5bbdbc2f7d4ffe5047662bfbd8f0c7fcd6d1b\n"
+          "CS_54b771f23f302a9f0b66cf4cfa99b5bd0b583d47\n"
+          "CS_5a02908ac17b564d31bcaf966930383af3cafeac\n";
+      }
+    }
+
+    std::lock_guard lock(g_wowSkipMutex);
+
+    if (contents == g_wowSkipContents)
+      return;
+
+    g_wowSkipContents = contents;
+
+    auto set = std::make_shared<WowSkipSet>();
+    size_t pos = 0;
+    bool zeroAlways = false;
+
+    while (pos <= contents.size()) {
+      size_t end = contents.find('\n', pos);
+
+      if (end == std::string::npos)
+        end = contents.size();
+
+      std::string line = contents.substr(pos, end - pos);
+      pos = end + 1;
+
+      size_t a = line.find_first_not_of(" \t\r");
+      size_t b = line.find_last_not_of(" \t\r");
+
+      if (a == std::string::npos)
+        continue;
+
+      line = line.substr(a, b - a + 1);
+
+      if (line[0] == '#') {
+        if (line == "#zero=always")
+          zeroAlways = true;
+        continue;
+      }
+
+      set->insert(line);
+    }
+
+    Logger::warn(str::format("SKIP: set updated: ", set->size(), " shaders",
