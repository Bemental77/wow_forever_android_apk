+  void DxvkContext::profMark(uint32_t type, std::string&& info) {
+    // Consecutive compute / transfer work is grouped into one segment,
+    // every render pass gets its own segment.
+    if (type == m_profCurType && type != ProfRp && type != ProfCs)
+      return;
+
+    if (m_profMarks.size() >= ProfMaxQueries)
+      return;
+
+    if (type == ProfNone && m_profCurType == ProfNone)
+      return;
+
+    uint32_t index = uint32_t(m_profMarks.size());
+    m_cmd->cmdWriteTimestamp(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, m_profPool, index);
+
+    ProfMark& mark = m_profMarks.emplace_back();
+    mark.type = type;
+    mark.info = std::move(info);
+
+    m_profCurType = type;
+  }
