+    Logger::warn(str::format("SKIP: zero mode: ", zeroAlways ? "always" : "first"));
+
+    g_wowZeroAlways.store(zeroAlways, std::memory_order_release);
+    g_wowSkipSeen.clear();
+    g_wowSkipAny.store(!set->empty(), std::memory_order_release);
+    g_wowSkipSet = std::move(set);
+    g_wowSkipVersion.fetch_add(1u, std::memory_order_acq_rel);
+  }
